<Shell
    x:Class="PizzaApp.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:PizzaApp"
    FlyoutBackgroundColor="#05013d">


    <Shell.ItemTemplate>
        <DataTemplate>
            <Grid Padding="15">
                <Label Text="{Binding Title}"
                       FontSize="18"
                       TextColor="White"/>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <FlyoutItem Title="Order">
        <ShellContent ContentTemplate="{DataTemplate local:MainPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Cart">
        <ShellContent ContentTemplate="{DataTemplate local:CartPage}" />
    </FlyoutItem>

    <FlyoutItem Title="Admin">
        <ShellContent ContentTemplate="{DataTemplate local:LoginPage}" />
    </FlyoutItem>

</Shell>