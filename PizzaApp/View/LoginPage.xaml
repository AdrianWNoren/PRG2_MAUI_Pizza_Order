<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PizzaApp.LoginPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             Title="Admin Login"
             BackgroundColor="White">
    <VerticalStackLayout Padding="40" Spacing="15" VerticalOptions="Center">

        <Label Text="Admin Login"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center"
               TextColor="#302833"/>

        <Label Text="Email:" FontAttributes="Bold" TextColor="#302833"/>
        <Entry Text="{Binding Email}"
               Placeholder="admin@pizzaapp.com"
               Keyboard="Email"
               TextColor="#302833"/>

        <Label Text="Password:" FontAttributes="Bold" TextColor="#302833"/>
        <Entry Text="{Binding Password}"
               Placeholder="Password"
               IsPassword="True"
               TextColor="#302833"/>

        <Label Text="{Binding ErrorMessage}"
               TextColor="#E63946"
               FontAttributes="Bold"
               IsVisible="{Binding ErrorMessage, Converter={x:StaticResource StringNotEmptyConverter}}"/>

        <ActivityIndicator IsRunning="{Binding IsLoading}"
                           IsVisible="{Binding IsLoading}"
                           Color="#1473c7"/>

        <Button Text="Login"
                Command="{Binding LoginCommand}"
                BackgroundColor="#1473c7"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50"
                Margin="0,10,0,0"/>

        <Button Text="Cancel"
                Command="{Binding CancelCommand}"
                BackgroundColor="#aaa"
                TextColor="White"
                FontAttributes="Bold"
                CornerRadius="10"
                HeightRequest="50"/>

    </VerticalStackLayout>
</ContentPage>
